# Copy this file to `.env` and fill in what you have.
# Everything here is optional - the site works fully without any of it.
# `.env` is gitignored, so secrets never reach the repo.

# ---------------------------------------------------------------------------
# Google Analytics 4  (free)
# ---------------------------------------------------------------------------
# Where to get it: analytics.google.com -> Admin -> Data streams -> Web.
# Takes about two minutes and also gives you Search Console.
#
# Until this is set, the site loads no analytics script and makes no requests
# to Google. Click events are still pushed to `dataLayer` so you can verify
# wiring in devtools.
#
# The same property also lets you register the sitemap in Search Console:
#   https://myfarmhouse.vercel.app/sitemap.xml
VITE_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Lead form storage  (free tier)
# ---------------------------------------------------------------------------
# Formspree: formspree.io -> New Form -> copy the endpoint URL.
#
# Leave blank and the form still works - submitting opens WhatsApp with the
# visitor's name and number already filled in. Set this only if you also want
# a spreadsheet/email copy of every enquiry.
VITE_FORMSPREE_ENDPOINT=