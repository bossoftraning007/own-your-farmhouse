{
  "name": "dads-realestate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Green Orchid Farm Land - HMDA approved 1BHK farmhouse near Kothur, Hyderabad",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run assets && tsc -b && vite build && npm run assets:verify",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "assets": "node scripts/generate-assets.mjs && node scripts/generate-posters.mjs",
    "assets:verify": "node scripts/generate-assets.mjs --verify-only && node scripts/verify-posters.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.1.1",
    "jsqr": "^1.4.0",
    "postcss": "^8.5.25",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^5.0.3"
  }
}
